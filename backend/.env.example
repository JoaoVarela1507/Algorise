ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173

# Fora do Docker use localhost; dentro do compose o host é `db`.
DATABASE_URL=postgresql+psycopg://algorise:algorise@localhost:5432/algorise

# Cache, ranking e streak. Mesma regra: fora do Docker é localhost, dentro do
# compose o host é `redis`. A API funciona sem ele, só mais lenta.
REDIS_URL=redis://localhost:6379/0

# Onde a API está exposta; o callback do OAuth é montado a partir daqui.
API_URL=http://localhost:8000

# Assina os tokens. Em desenvolvimento pode ficar em branco (usa um segredo de
# teste); em produção a API não sobe sem um valor forte:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Apps OAuth. Em branco, o botão correspondente responde 503.
# GitHub: Settings > Developer settings > OAuth Apps, callback
#   http://localhost:8000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google: console do Google Cloud > Credenciais > ID do cliente OAuth, callback
#   http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Preenchidos pelo CI no build; deixe em branco em desenvolvimento.
GIT_COMMIT=
BUILD_TIME=
