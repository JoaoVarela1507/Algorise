ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173

# Fora do Docker use localhost; dentro do compose o host é `db`.
DATABASE_URL=postgresql+psycopg://algorise:algorise@localhost:5432/algorise
# Supabase: use o Session pooler (IPv4 e compatível com o psycopg), não o host
# direto (só IPv6) nem o Transaction pooler da porta 6543. Senha URL-encoded.
# DATABASE_URL=postgresql+psycopg://postgres.<id-do-projeto>:<senha>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# Cache, ranking e streak. Mesma regra: fora do Docker é a máquina, dentro do
# compose o host é `redis`. A API funciona sem ele, só mais lenta. Use
# `127.0.0.1`, e não `localhost`: no Windows o `localhost` tenta o IPv6 antes e
# cada conexão nova espera 2 s até cair no IPv4.
REDIS_URL=redis://127.0.0.1:6379/0

# IA do chat (#11). Fora do Docker é o Ollama instalado na máquina; dentro do
# compose o host é `ollama`. `IA_PROVEDOR=eco` responde sem IA nenhuma (devolve
# a pergunta), para rodar o chat sem o Ollama; em produção não é aceito.
# `IA_PROVEDOR=gemini` usa a API do Gemini (ver abaixo).
IA_PROVEDOR=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=llama3.2
# Tarefas do worker; em branco, o mesmo do chat.
OLLAMA_MODELO_TAREFAS=
# Embedding do vault das skills (#200); ver o .env.example da raiz.
OLLAMA_MODELO_EMBEDDING=bge-m3

# Segunda opção de IA: `IA_PROVEDOR=gemini`, sem Ollama nenhum na máquina. Chave
# grátis em https://aistudio.google.com/apikey (nunca commite a chave).
GEMINI_API_KEY=
GEMINI_MODELO=gemini-flash-lite-latest
GEMINI_MODELO_TAREFAS=
GEMINI_MODELO_EMBEDDING=gemini-embedding-001
# Um modelo do Gemini por uso da IA (chat, resumo, correcao, exercicios, ementa,
# categorizacao, segmentacao), para um não gastar a cota do outro. Em JSON; o que
# faltar usa o padrão de `app/core/config.py` (o chat usa o GEMINI_MODELO).
# GEMINI_MODELOS={"correcao": "gemini-3.1-flash-lite"}
# Com o Gemini: embeddings do vault no Ollama (sem cota; trocar pede reingerir
# o vault) e o Ollama de reserva quando o Gemini falhar antes de responder.
IA_PROVEDOR_EMBEDDINGS=
IA_RESERVA=
# Segundos que um modelo do Gemini que falhou fica pausado, indo direto à reserva.
IA_PAUSA_APOS_FALHA=60
# `keep_alive` do Ollama (ex.: 30m). Com valor e IA_RESERVA=ollama, a API carrega o
# modelo de reserva ao subir, para a primeira troca não levar mais de um minuto.
OLLAMA_MANTER_CARREGADO=
# Distância de cosseno até o módulo mais próximo abaixo da qual um assunto da
# ementa conta como coberto pelo catálogo (#38); acima, vira lacuna.
EMENTA_DISTANCIA_MAXIMA=0.35

# Onde roda o trabalho longo (a leitura da ementa). `local` roda no processo da
# API, sem worker; o compose usa `redis`, com o serviço `worker` (#206).
FILA=local

# Busca de vídeos para as lacunas das ementas (#207); ver o .env.example da raiz.
YOUTUBE_API_KEY=

# Assina os JWT. Em desenvolvimento pode ficar em branco (cai no segredo de
# desenvolvimento); em produção a API se recusa a subir sem um valor próprio.
# Gere um com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Login social. Crie os apps no GitHub e no Google e aponte o callback para
# http://localhost:8000/api/v1/auth/github/callback e .../api/v1/auth/google/callback.
# NUNCA commite os secrets: este arquivo fica com as chaves em branco.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Preenchidos pelo CI no build; deixe em branco em desenvolvimento.
GIT_COMMIT=
BUILD_TIME=

# Logs (#39): `json` ou `texto`. Vazio, `json` em produção e `texto` no resto.
LOG_FORMATO=
# Sentry e token das métricas: ver o .env.example da raiz.
SENTRY_DSN=
METRICAS_TOKEN=
