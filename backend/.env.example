ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173

# Fora do Docker use localhost; dentro do compose o host é `db`.
DATABASE_URL=postgresql+psycopg://algorise:algorise@localhost:5432/algorise

# Cache, ranking e streak. Mesma regra: fora do Docker é localhost, dentro do
# compose o host é `redis`. A API funciona sem ele, só mais lenta.
REDIS_URL=redis://localhost:6379/0

# Preenchidos pelo CI no build; deixe em branco em desenvolvimento.
GIT_COMMIT=
BUILD_TIME=
