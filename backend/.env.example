ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173

# Fora do Docker use localhost; dentro do compose o host é `db`.
DATABASE_URL=postgresql+psycopg://algorise:algorise@localhost:5432/algorise
# Supabase: use o Session pooler (IPv4 e compatível com o psycopg), não o host
# direto (só IPv6) nem o Transaction pooler da porta 6543. Senha URL-encoded.
# DATABASE_URL=postgresql+psycopg://postgres.<id-do-projeto>:<senha>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# Cache, ranking e streak. Mesma regra: fora do Docker é localhost, dentro do
# compose o host é `redis`. A API funciona sem ele, só mais lenta.
REDIS_URL=redis://localhost:6379/0

# IA do chat (#11). Fora do Docker é o Ollama instalado na máquina; dentro do
# compose o host é `ollama`. `IA_PROVEDOR=eco` responde sem IA nenhuma (devolve
# a pergunta), para rodar o chat sem o Ollama; em produção não é aceito.
IA_PROVEDOR=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=llama3.2
# Embedding do vault das skills (#200); ver o .env.example da raiz.
OLLAMA_MODELO_EMBEDDING=bge-m3
# Distância de cosseno até o módulo mais próximo abaixo da qual um assunto da
# ementa conta como coberto pelo catálogo (#38); acima, vira lacuna.
EMENTA_DISTANCIA_MAXIMA=0.35

# Assina os JWT. Em desenvolvimento pode ficar em branco (cai no segredo de
# desenvolvimento); em produção a API se recusa a subir sem um valor próprio.
# Gere um com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Login social. Crie os apps no GitHub e no Google e aponte o callback para
# http://localhost:8000/api/v1/auth/github/callback e .../api/v1/auth/google/callback.
# NUNCA commite os secrets: este arquivo fica com as chaves em branco.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Preenchidos pelo CI no build; deixe em branco em desenvolvimento.
GIT_COMMIT=
BUILD_TIME=
