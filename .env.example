# Variáveis do docker compose. Tudo opcional em desenvolvimento.

# Banco. Em branco usa o PostgreSQL do serviço `db`; para o Supabase use o
# Session pooler (ver backend/README.md).
DATABASE_URL=

# Assina os tokens. Em branco vale o segredo de desenvolvimento; o perfil de
# produção (-f docker-compose.yml) não sobe sem um valor de 32+ caracteres.
JWT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
