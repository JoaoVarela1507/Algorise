# Variáveis do docker compose. Tudo opcional em desenvolvimento.

# Banco. Em branco usa o PostgreSQL do serviço `db`; para o Supabase use o
# Session pooler (ver backend/README.md).
DATABASE_URL=

# Assina os tokens. Em branco vale o segredo de desenvolvimento; o perfil de
# produção (-f docker-compose.yml) não sobe sem um valor de 32+ caracteres.
JWT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Modelo do chat (#11), baixado pelo serviço `ollama-modelo` na subida. Em
# branco usa o llama3.2.
OLLAMA_MODELO=

# Modelo das tarefas do worker (leitura da ementa, vídeos, exercícios), também
# baixado na subida. Em branco usa o llama3.2, o mesmo do chat. Um modelo menor é
# mais rápido na CPU, mas o llama3.2:1b quebrou o JSON na leitura do PPC.
OLLAMA_MODELO_TAREFAS=

# Modelo de embedding do vault das skills (#200), baixado junto. Em branco usa o
# bge-m3. Trocar de modelo pede migração nova (a dimensão do vetor é fixa) e
# reingerir o vault.
OLLAMA_MODELO_EMBEDDING=

# Busca de vídeos no YouTube para os assuntos das ementas que o catálogo não
# cobre (#207). Chave da YouTube Data API v3, criada no Google Cloud Console.
# Vazia, a busca fica desligada.
YOUTUBE_API_KEY=

# Observabilidade (#39). Sem o DSN, a captura de exceções no Sentry fica desligada.
SENTRY_DSN=
# Com valor, `GET /metrics` pede `Authorization: Bearer <token>`. Em produção, defina.
METRICAS_TOKEN=

# Sandbox do desafio de código (#34). `desligada` recusa as execuções numa
# máquina sem Docker. Em produção, `SANDBOX_RUNTIME=runsc` usa o gVisor.
# `DOCKER_GID` é o grupo dono de /var/run/docker.sock no host (`stat -c %g`).
SANDBOX_MODO=docker
SANDBOX_RUNTIME=
DOCKER_GID=
